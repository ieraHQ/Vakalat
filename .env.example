# Copy to .env and adjust before running `docker compose up`.

JWT_SECRET=change-me-in-production

# Local LLM endpoint (OpenAI-compatible). Defaults assume Ollama running on
# the host machine, reachable from containers via host.docker.internal.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_MODEL=llama3.1
# 384-dimension embedding model to match the schema's VECTOR(384) columns
# (Ollama: "all-minilm").
AI_EMBEDDING_MODEL=all-minilm

# Server-only — read by the web container to reach the api container over the
# docker network. Never rename this to NEXT_PUBLIC_*: that would bake it into
# the browser bundle at build time instead of reading it at request time.
API_BASE_URL=http://api:8080/api

# Set to "true" only once a real TLS/ingress layer is in front of the app —
# secure cookies are silently dropped by browsers over plain HTTP.
COOKIE_SECURE=false
